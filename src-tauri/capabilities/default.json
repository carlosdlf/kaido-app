{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "allow-pick-workspace-folder",
    "allow-open-workspace",
    "allow-list-files",
    "allow-read-file",
    "allow-write-file",
    "allow-rename-file",
    "allow-delete-file",
    "allow-read-settings",
    "allow-write-settings",
    "allow-git-status",
    "allow-git-commit",
    "allow-git-sync",
    "allow-git-version",
    "allow-git-clone",
    "allow-git-clone-cancel",
    "allow-scaffold-workspace",
    "allow-ensure-workspace-files",
    "allow-workspace-setup-status",
    "allow-capture-shortcut-status",
    "allow-set-capture-shortcut"
  ]
}
