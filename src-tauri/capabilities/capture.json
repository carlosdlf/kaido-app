{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "Quick capture window: listens to events and relays captures through its own commands",
  "windows": ["capture"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-capture-submit",
    "allow-capture-request-projects",
    "allow-capture-hide",
    "allow-capture-show",
    "allow-capture-set-height"
  ]
}
